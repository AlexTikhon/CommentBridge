DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_comments?schema=public"
POSTGRES_PORT=5432
POSTGRES_TEST_PORT=55433
PORT=3000

# Delivery operations endpoints (status, retry, dead-letter, stats) require
# "Authorization: Bearer <key>". Format: operatorId=key[,operatorId=key]. Keys must
# be at least 32 characters (for example: openssl rand -hex 32). Leave empty to keep
# these endpoints closed. Never commit real keys.
OPERATOR_API_KEYS=

# Delivery worker (all optional; values shown are the defaults). The worker is a
# separate process ("pnpm start:worker"); the API never runs it. The API reads
# DELIVERY_WORKER_STALE_AFTER_MS to classify workers in GET /api/v1/deliveries/stats,
# so give both processes the same value.
# Startup fails fast if the combination is unsafe: the lease must outlive the
# provider timeout, the base retry delay must not exceed the maximum, the
# reconciliation quota must not exceed the per-tick job budget, and the stale
# threshold must exceed the heartbeat interval (3x is a good margin).
DELIVERY_POLL_INTERVAL_MS=1000
DELIVERY_LEASE_DURATION_MS=30000
DELIVERY_PROVIDER_TIMEOUT_MS=10000
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BASE_RETRY_DELAY_MS=1000
DELIVERY_MAX_RETRY_DELAY_MS=60000
DELIVERY_MAX_JOBS_PER_TICK=10
DELIVERY_MAX_RECONCILIATIONS_PER_TICK=3
DELIVERY_WORKER_HEARTBEAT_INTERVAL_MS=10000
DELIVERY_WORKER_STALE_AFTER_MS=30000

# Delivery history retention (worker process only; values shown are the defaults).
# Only finished ReplyDeliveryAttempt rows and operator audit rows
# (ReplyDeliveryManualAction) are ever pruned, never ReplyDelivery itself, and only
# for deliveries that are SUCCEEDED, FAILED, or DEAD_LETTERED. The newest
# MIN_ATTEMPTS_PER_DELIVERY attempts of each delivery are always kept. Startup fails
# if the audit retention is shorter than the attempt retention.
DELIVERY_RETENTION_ENABLED=true
DELIVERY_ATTEMPT_RETENTION_DAYS=90
DELIVERY_MANUAL_ACTION_RETENTION_DAYS=365
DELIVERY_RETENTION_INTERVAL_MS=3600000
DELIVERY_RETENTION_BATCH_SIZE=500
DELIVERY_RETENTION_MIN_ATTEMPTS_PER_DELIVERY=3

# Operational health thresholds for GET /api/v1/deliveries/health (read by the API
# process; values shown are the defaults). All *_MS values are milliseconds and all
# thresholds are inclusive: a value equal to the threshold already has that severity.
# Startup fails if a CRITICAL threshold is not above its WARN threshold.
# Whether no worker at all is an issue (set false for a deployment without a worker).
DELIVERY_HEALTH_WORKER_REQUIRED=true
# How long with no active worker (counted from when the last one went stale, or from
# API start if none was ever seen) is DEGRADED before it becomes CRITICAL. 0 = none.
DELIVERY_HEALTH_NO_WORKER_GRACE_MS=60000
# Age of the oldest *due* PENDING/RETRY delivery. Retries scheduled for later are not due.
DELIVERY_HEALTH_QUEUE_LAG_WARN_MS=60000
DELIVERY_HEALTH_QUEUE_LAG_CRITICAL_MS=300000
# Age of the oldest unresolved UNKNOWN delivery (since its provider call began).
DELIVERY_HEALTH_UNKNOWN_AGE_WARN_MS=300000
DELIVERY_HEALTH_UNKNOWN_AGE_CRITICAL_MS=1800000
# Retention is overdue after this many DELIVERY_RETENTION_INTERVAL_MS without a
# successful run. Must be greater than 1; may be fractional (for example 2.5).
DELIVERY_HEALTH_RETENTION_OVERDUE_MULTIPLIER=3
