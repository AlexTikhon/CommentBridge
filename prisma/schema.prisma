generator client {
  provider = "prisma-client-js"
}

// `url` is what the API and worker connect with: a restricted runtime role.
// `directUrl` is used by the Prisma CLI (migrate deploy) and must name a role that
// owns the schema. The runtime never reads it.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("MIGRATION_DATABASE_URL")
}

enum SocialPlatform {
  INSTAGRAM
  LINKEDIN
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  FAILED
}

enum CommentDirection {
  INBOUND
  OUTBOUND
}

enum DeliveryStatus {
  RECEIVED
  PENDING
  SENT
  FAILED
}

enum ReplyDeliveryStatus {
  PENDING
  PROCESSING
  RETRY
  SUCCEEDED
  FAILED
  UNKNOWN
  DEAD_LETTERED
}

enum ReplyDeliveryAttemptStatus {
  PROCESSING
  SUCCEEDED
  RETRYABLE_FAILURE
  TERMINAL_FAILURE
  UNKNOWN
}

enum ReplyDeliveryManualActionType {
  RETRY
  DEAD_LETTER
}

model SocialAccount {
  id                String            @id @default(uuid()) @db.Uuid
  platform          SocialPlatform
  externalAccountId String
  displayName       String
  createdAt         DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(3)
  publications      PostPublication[]

  @@unique([platform, externalAccountId])
}

model Post {
  id           String            @id @default(uuid()) @db.Uuid
  content      String
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  publications PostPublication[]
}

model PostPublication {
  id              String            @id @default(uuid()) @db.Uuid
  postId          String            @db.Uuid
  socialAccountId String            @db.Uuid
  externalPostId  String
  status          PublicationStatus
  publishedAt     DateTime?         @db.Timestamptz(3)
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(3)
  post            Post              @relation(fields: [postId], references: [id], onDelete: Cascade)
  socialAccount   SocialAccount     @relation(fields: [socialAccountId], references: [id], onDelete: Restrict)
  comments        Comment[]

  @@unique([socialAccountId, externalPostId])
  @@index([postId, socialAccountId])
}

model Comment {
  id                String           @id @default(uuid()) @db.Uuid
  postPublicationId String           @db.Uuid
  parentId          String?          @db.Uuid
  externalCommentId String?
  direction         CommentDirection
  deliveryStatus    DeliveryStatus
  idempotencyKey    String?
  authorExternalId  String?
  authorDisplayName String
  body              String
  providerErrorCode String?
  remoteCreatedAt   DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  // Listing order. Set by a trigger at insertion (remoteCreatedAt, else createdAt) and
  // immutable afterwards; the default only satisfies NOT NULL for inserts that omit it.
  paginationAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)
  postPublication   PostPublication  @relation(fields: [postPublicationId], references: [id], onDelete: Cascade)
  parent            Comment?         @relation("CommentReplies", fields: [parentId, postPublicationId], references: [id, postPublicationId], onDelete: Restrict)
  replies           Comment[]        @relation("CommentReplies")
  delivery          ReplyDelivery?

  @@unique([postPublicationId, externalCommentId])
  @@unique([parentId, idempotencyKey])
  @@unique([id, postPublicationId])
  @@index([postPublicationId, paginationAt(sort: Desc), id(sort: Desc)])
  @@index([parentId, paginationAt(sort: Desc), id(sort: Desc)])
}

model ReplyDelivery {
  id            String                      @id @default(uuid()) @db.Uuid
  replyId       String                      @unique @db.Uuid
  status        ReplyDeliveryStatus         @default(PENDING)
  attemptCount  Int                         @default(0)
  nextAttemptAt DateTime                    @default(now()) @db.Timestamptz(3)
  leaseUntil    DateTime?                   @db.Timestamptz(3)
  leaseToken    String?                     @db.Uuid
  lastErrorCode String?
  createdAt     DateTime                    @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime                    @updatedAt @db.Timestamptz(3)
  reply         Comment                     @relation(fields: [replyId], references: [id], onDelete: Cascade)
  attempts      ReplyDeliveryAttempt[]
  manualActions ReplyDeliveryManualAction[]

  @@index([status, nextAttemptAt, id])
  @@index([status, leaseUntil])
}

model ReplyDeliveryManualAction {
  id              String                        @id @default(uuid()) @db.Uuid
  deliveryId      String                        @db.Uuid
  action          ReplyDeliveryManualActionType
  actorId         String                        @db.VarChar(200)
  reason          String                        @db.VarChar(1000)
  previousStatus  ReplyDeliveryStatus
  resultingStatus ReplyDeliveryStatus
  createdAt       DateTime                      @default(now()) @db.Timestamptz(3)
  delivery        ReplyDelivery                 @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([deliveryId, createdAt, id])
}

model ReplyDeliveryAttempt {
  id            String                     @id @default(uuid()) @db.Uuid
  deliveryId    String                     @db.Uuid
  attemptNumber Int
  status        ReplyDeliveryAttemptStatus @default(PROCESSING)
  errorCode     String?
  startedAt     DateTime                   @default(now()) @db.Timestamptz(3)
  finishedAt    DateTime?                  @db.Timestamptz(3)
  delivery      ReplyDelivery              @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([status, startedAt])
}

// One row per delivery-worker process lifetime. Liveness is the heartbeat age;
// the lastDrain* columns describe the most recent drain that did work, and the
// lastRetention* columns the most recent retention pass of this process. The
// success and failure timestamps are independent so health can tell which is newer.
model DeliveryWorkerInstance {
  instanceId                        String    @id @db.VarChar(200)
  startedAt                         DateTime  @db.Timestamptz(3)
  lastHeartbeatAt                   DateTime  @db.Timestamptz(3)
  lastDrainCompletedAt              DateTime? @db.Timestamptz(3)
  lastDrainDurationMs               Int       @default(0)
  lastDrainProcessedCount           Int       @default(0)
  lastDrainSucceededCount           Int       @default(0)
  lastDrainRetryCount               Int       @default(0)
  lastDrainFailedCount              Int       @default(0)
  lastDrainUnknownCount             Int       @default(0)
  lastDrainLeaseLostCount           Int       @default(0)
  lastDrainExpiredLeases            Int       @default(0)
  lastRetentionSucceededAt          DateTime? @db.Timestamptz(3)
  lastRetentionFailedAt             DateTime? @db.Timestamptz(3)
  lastRetentionDurationMs           Int       @default(0)
  lastRetentionDeletedAttempts      Int       @default(0)
  lastRetentionDeletedManualActions Int       @default(0)
  lastRetentionFailureCode          String?   @db.VarChar(100)
  createdAt                         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt                         DateTime  @updatedAt @db.Timestamptz(3)

  @@index([lastHeartbeatAt])
}
