# Settings for the DISPOSABLE test database only: an in-memory PostgreSQL container
# (`pnpm db:test:up`) published on 127.0.0.1. The passwords below protect nothing but
# throwaway test data and must never be reused anywhere else.
#
# Machine-specific overrides (for example a different port when 55433 is taken) go in
# .env.test.local, which is git-ignored and loaded after this file.
NODE_ENV=test
POSTGRES_TEST_PORT=55433
POSTGRES_TEST_ADMIN_PASSWORD=disposable-test-admin-password
COMMENTBRIDGE_API_DB_PASSWORD=disposable-test-api-password
COMMENTBRIDGE_WORKER_DB_PASSWORD=disposable-test-worker-password

# Administrative access: migrations, role provisioning and test fixtures only.
MIGRATION_DATABASE_URL="postgresql://postgres:disposable-test-admin-password@127.0.0.1:55433/commentbridge_test?schema=public"
# The code under test connects as the restricted runtime roles.
DATABASE_URL="postgresql://commentbridge_api:disposable-test-api-password@127.0.0.1:55433/commentbridge_test?schema=public"
WORKER_DATABASE_URL="postgresql://commentbridge_worker:disposable-test-worker-password@127.0.0.1:55433/commentbridge_test?schema=public"

OPERATOR_API_KEYS=e2e-operator=e2e-operator-test-key-0123456789abcdef
